{
  "manifest_version": 3,
  "name": "微博列表拉黑",
  "version": "1.3.3",
  "description": "在首页/热门/分组/搜索等流中拉黑/本机屏蔽并隐藏卡片；在扩展详情页的「扩展程序选项」中管理名单与解黑。",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.weibo.com/*",
        "https://weibo.com/*",
        "https://s.weibo.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "scripting",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://www.weibo.com/*",
    "https://weibo.com/*",
    "https://s.weibo.com/*"
  ]
}
